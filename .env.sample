# Copy to .env.local and fill in. Never commit .env.local.
# Check every key with: npm run test:smoke

# --- Supabase (Project Settings > API keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service-role key. Server only: it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Keep this as localhost here. Production gets https://majnu.app from .env.production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave unset until Stripe takes live payments: everyone gets Full moon features
# and only the spending guard applies. Set to "on" to enforce plans.
MAJNU_BILLING=

# --- Open tracking. Server only. ---
# Mixed into the visitor hash in /api/open, so a stored visitor id cannot be
# traced back to an IP address. Any long random string, e.g. `openssl rand -hex 32`.
# Changing it makes every returning visitor count as new. Without it, opens are not recorded.
OPEN_HASH_SECRET=

# --- Anthropic (console.anthropic.com > API keys). Server only. ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5; claude-sonnet-5-5 is faster and cheaper.
MAJNU_MODEL=
# Optional, server only. Tavily (app.tavily.com > API keys) runs the gift research web search; empty uses Anthropic's web search.
TAVILY_API_KEY=

# --- Stripe (Dashboard > Developers > API keys) ---
# Secret key is server only. Test keys start with sk_test_ / pk_test_.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Optional ---
# Shown as a "pay what you want" link if Stripe is not live.
NEXT_PUBLIC_TIP_URL=
# Only for the Daytona redesign extra (app.daytona.io > API keys). Server only.
DAYTONA_API_KEY=
# Black Forest Labs (FLUX), for coding agents generating images and video for
# the site during development (dashboard.bfl.ai > API keys). Not used by the
# running app.
BFL_API_KEY=
