# Copy to .env.local and fill in. Never commit .env.local.
# Check every key with: npm run test:smoke

# --- Supabase (Project Settings > API keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service-role key. Server only: it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Keep this as localhost here. Production gets https://majnu.app from .env.production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# --- Open tracking. Server only. ---
# Mixed into the visitor hash in /api/open, so a stored visitor id cannot be
# traced back to an IP address. Any long random string, e.g. `openssl rand -hex 32`.
# Changing it makes every returning visitor count as new. Without it, opens are not recorded.
OPEN_HASH_SECRET=

# --- Anthropic (console.anthropic.com > API keys). Server only. ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5; claude-sonnet-5-5 is faster and cheaper.
MAJNU_MODEL=
# Optional, server only. Tavily (app.tavily.com > API keys) runs the gift research web search; empty uses Anthropic's web search.
TAVILY_API_KEY=

# --- Stripe (Dashboard > Developers > API keys) ---
# Secret key is server only. Test keys start with sk_test_ / pk_test_.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The personalised wrapper's one-time €2.99 price, VAT included (Dashboard > Product catalog >
# "Majnu personalised wrapper" > the price's id, price_...). Test and live mode have different ids.
# Test mode: price_1UeMy7Ieh8tCba0kv2rSa9af (lookup key majnu_wrapper_eur_299).
STRIPE_PRICE_WRAPPER=
# Signing secret of the webhook endpoint https://majnu.app/api/stripe/webhook (whsec_...),
# subscribed to checkout.session.completed, .async_payment_succeeded, .async_payment_failed and .expired.
STRIPE_WEBHOOK_SECRET=

# --- Optional ---
# Shown as a "pay what you want" link if Stripe is not live.
NEXT_PUBLIC_TIP_URL=
# The personalised wrapper's design job (app.daytona.io > API keys). Server only.
DAYTONA_API_KEY=
# Black Forest Labs (FLUX), for coding agents generating images and video for
# the site during development (dashboard.bfl.ai > API keys). Not used by the
# running app.
BFL_API_KEY=

# --- Cloudflare Turnstile (invisible bot check before anonymous sign-in) ---
# Public site key; the secret is set in Supabase > Authentication > Bot and Abuse Protection, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Daytona redesigns (all optional; see docs/plan.md, Daytona redesign) ---
# A separate low-limit Anthropic key for Claude Code in the sandbox; falls back to ANTHROPIC_API_KEY.
DAYTONA_ANTHROPIC_API_KEY=
# Defaults: snapshot majnu-letters-v1, region eu, API https://app.daytona.io/api
DAYTONA_SNAPSHOT=
DAYTONA_TARGET=
DAYTONA_API_URL=

# --- OpenAI (speech to text only: voice input and audio-note captions; called with fetch, no SDK) ---
OPENAI_API_KEY=

# Gift finder: site-wide gift searches per UTC day (default 300; 0 switches searches off).
MAJNU_DAILY_SEARCH_CAP=

# --- Apify (console.apify.com > Settings > API & Integrations). Server only. ---
# Reads a public Instagram or TikTok profile when a sender pastes one into the gift finder. Empty switches it off.
APIFY_API_TOKEN=
# Instagram and TikTok profile reads the whole site may run per UTC day (default 20; 0 switches them off). The Apify credit is $5.
APIFY_DAILY_CAP=
